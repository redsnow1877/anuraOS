#! {"lang":"module"}
// ping: round trips to a host over HTTPS, through the relay. There's no raw
// ICMP in a browser, so this times a HEAD request instead.
//   ping github.com
//   ping -c 8 example.com

export async function main(args) {
	let count = 4;
	let host = "";
	for (let i = 0; i < args.length; i++) {
		if (args[i] === "-c") count = Math.max(1, Math.min(100, Number(args[++i]) || 4));
		else host = args[i];
	}
	if (!host) {
		eprintln("usage: ping [-c count] host");
		exit(1);
		return;
	}
	host = host.replace(/^https?:\/\//, "").replace(/\/.*$/, "");
	const relay = window.parent.DimensionRelay;
	println(
		`PING ${host} over HTTPS via ${relay ? relay.name(relay.current) : "the relay"}`,
	);
	const times = [];
	for (let seq = 1; seq <= count; seq++) {
		const t0 = performance.now();
		try {
			const res = await Promise.race([
				anura.net.fetch(`https://${host}/`, { method: "HEAD", cache: "no-store" }),
				new Promise((_, rej) => setTimeout(() => rej(new Error("timeout")), 8000)),
			]);
			const ms = performance.now() - t0;
			times.push(ms);
			println(`reply from ${host}: seq=${seq} status=${res.status} time=${ms.toFixed(1)} ms`);
		} catch (e) {
			println(`no reply from ${host}: seq=${seq} (${e?.message || e})`);
		}
		if (seq < count) await new Promise((r) => setTimeout(r, 700));
	}
	const ok = times.length;
	println("");
	println(`--- ${host} ---`);
	println(`${count} sent, ${ok} received, ${Math.round(((count - ok) / count) * 100)}% lost`);
	if (ok) {
		const min = Math.min(...times);
		const max = Math.max(...times);
		const avg = times.reduce((a, b) => a + b, 0) / ok;
		println(`min/avg/max = ${min.toFixed(1)}/${avg.toFixed(1)}/${max.toFixed(1)} ms`);
	}
	exit(0);
}
